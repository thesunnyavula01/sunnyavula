# Mirror of the active keys in .env.local — no real values here.
# See CLAUDE.md → "Environment variables" for what each one does.

# ── Site (build-time, inlined into the client bundle) ──
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=

# ── Cloudflare deploy (read by Wrangler from the environment; prefer CI secrets) ──
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
