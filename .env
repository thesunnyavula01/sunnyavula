# Committed, NON-SECRET build-time config (inlined into the client bundle).
# CI (Workers Builds) has no .env.local, so these defaults make CI builds emit
# correct metadata/OG/sitemap URLs. .env.local still overrides locally.
# Never put a secret in this file — secrets go in .env.local / CI secrets.

# NOTE: the canonical site origin is now HARDCODED in content/sections.ts
# (SITE.url) so sitemap/canonicals can never emit a non-production host.
# This var is kept only for reference/tooling; the app no longer reads it.
NEXT_PUBLIC_SITE_URL=https://sunnyavula.com
NEXT_PUBLIC_SITE_NAME=Sunny Avula
NEXT_PUBLIC_CONTACT_EMAIL=abhiram.avula01@gmail.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/divcollective01
